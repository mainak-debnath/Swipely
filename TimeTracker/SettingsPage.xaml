<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TimeTracker.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="TimeTracker.SettingsPage"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:EnabledToColorConverter x:Key="EnabledToColorConverter" />
            <local:EnabledToTextColorConverter x:Key="EnabledToTextColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,18,24,28" Spacing="18">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Settings"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="Control your daily goal, choose the app theme, and manage saved history."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>

                <Border Padding="22"
                        StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{AppThemeBinding Light={StaticResource HeroStartLight}, Dark={StaticResource HeroStartDark}}" Offset="0.0" />
                            <GradientStop Color="{AppThemeBinding Light={StaticResource HeroMidLight}, Dark={StaticResource HeroMidDark}}" Offset="0.55" />
                            <GradientStop Color="{AppThemeBinding Light={StaticResource HeroEndLight}, Dark={StaticResource HeroEndDark}}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">
                        <Border Padding="10,6"
                                HorizontalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light={StaticResource HeroGlassLight}, Dark={StaticResource HeroGlassDark}}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="999" />
                            </Border.StrokeShape>
                            <Label Text="Daily target"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}" />
                        </Border>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Keep the whole app aligned with your actual office day."
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}" />
                            <Label Text="Swipely uses these goals for the dashboard, calendar states, and future reminders."
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource HeroSubtleLight}, Dark={StaticResource HeroSubtleDark}}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,Auto,*"
                              ColumnSpacing="12"
                              VerticalOptions="Center">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource HeroGlassLight}, Dark={StaticResource HeroGlassDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource HeroTrackLight}, Dark={StaticResource HeroTrackDark}}"
                                    StrokeThickness="1"
                                    Padding="14,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Label Text="Target"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource HeroSubtleLight}, Dark={StaticResource HeroSubtleDark}}" />
                            </Border>

                            <Border Grid.Column="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceLight}}"
                                    StrokeThickness="0"
                                    Padding="0"
                                    WidthRequest="110"
                                    HeightRequest="56">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Entry x:Name="HoursEntry"
                                       Keyboard="Numeric"
                                       Placeholder="8.0"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource Accent}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource HeroFieldPlaceholderLight}, Dark={StaticResource HeroFieldPlaceholderDark}}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       FontSize="22"
                                       FontAttributes="Bold" />
                            </Border>

                            <Label Grid.Column="2"
                                   Text="hours per day"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource HeroSubtleLight}, Dark={StaticResource HeroSubtleDark}}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,Auto,*"
                              ColumnSpacing="12"
                              VerticalOptions="Center">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource HeroGlassLight}, Dark={StaticResource HeroGlassDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource HeroTrackLight}, Dark={StaticResource HeroTrackDark}}"
                                    StrokeThickness="1"
                                    Padding="14,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Label Text="Presence"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource HeroSubtleLight}, Dark={StaticResource HeroSubtleDark}}" />
                            </Border>

                            <Border Grid.Column="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceLight}}"
                                    StrokeThickness="0"
                                    Padding="0"
                                    WidthRequest="110"
                                    HeightRequest="56">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Entry x:Name="OfficeDaysEntry"
                                       Keyboard="Numeric"
                                       Placeholder="3"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource Accent}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource HeroFieldPlaceholderLight}, Dark={StaticResource HeroFieldPlaceholderDark}}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       FontSize="22"
                                       FontAttributes="Bold" />
                            </Border>

                            <Label Grid.Column="2"
                                   Text="days per week"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource HeroSubtleLight}, Dark={StaticResource HeroSubtleDark}}" />
                        </Grid>

                        <Button x:Name="SaveGoalButton"
                                Text="Save Goals"
                                Clicked="OnSaveClicked"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceLight}}"
                                TextColor="{StaticResource Accent}"
                                FontAttributes="Bold"
                                HeightRequest="52"
                                FontSize="16"
                                Pressed="SaveGoalButton_Pressed"
                                Released="SaveGoalButton_Released" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Appearance"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Text="Pick how Swipely should look, without leaving your colors up to the phone."
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12"
                              VerticalOptions="Center">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="App theme"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="Auto follows the phone. Light and Dark lock Swipely to its own palette."
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>

                            <Border x:Name="ThemeSelectorButton"
                                    Grid.Column="1"
                                    Padding="14,10"
                                    MinimumWidthRequest="148"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ThemeSelector_Tapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="10"
                                      VerticalOptions="Center">
                                    <Border WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="17" />
                                        </Border.StrokeShape>
                                        <Label x:Name="ThemeSelectorIcon"
                                               Text="A"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Accent}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="1"
                                                         VerticalOptions="Center">
                                        <Label Text="Mode"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Label x:Name="ThemeSelectorLabel"
                                               Text="Auto"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="v"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Accent}"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Notifications"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Text="Get a nudge when your target is done or a session runs unusually long."
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Goal reached"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="Notify once per day when your required hours are complete."
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    Padding="2"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Switch x:Name="GoalNotificationSwitch"
                                        OnColor="{StaticResource Accent}"
                                        ThumbColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource TextPrimaryDark}}"
                                        Toggled="GoalNotificationSwitch_Toggled"
                                        VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}"
                                 Opacity="0.8" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Long session reminder"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="Useful when you forget to swipe out after leaving."
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    Padding="2"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Switch x:Name="LongSessionNotificationSwitch"
                                        OnColor="{StaticResource Accent}"
                                        ThumbColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource TextPrimaryDark}}"
                                        Toggled="LongSessionNotificationSwitch_Toggled"
                                        VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <Grid x:Name="LongSessionReminderSettings"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="10"
                              VerticalOptions="Center">
                            <Label x:Name="LongSessionReminderLabel"
                                   Text="Remind after"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center" />
                            <Border x:Name="LongSessionHoursBorder"
                                    Grid.Column="1"
                                    WidthRequest="76"
                                    HeightRequest="44"
                                    Padding="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Entry x:Name="LongSessionHoursEntry"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       Unfocused="LongSessionHoursEntry_Unfocused" />
                            </Border>
                            <Label x:Name="LongSessionHoursUnitLabel"
                                   Grid.Column="2"
                                   Text="hours"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Data management"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Text="Clear a month when you want to restart cleanly, or remove everything if the whole log should reset."
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>

                        <Button Text="Clear Monthly Data"
                                Clicked="OnClearMonthClicked"
                                BackgroundColor="{StaticResource Warning}"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="50"
                                FontSize="16" />

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}"
                                 Opacity="0.8" />

                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource DangerSoftLight}, Dark={StaticResource DangerSoftDark}}"
                                StrokeThickness="0"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="12">
                                    <Label x:Name="DangerZoneIcon"
                                           Text=">"
                                           Rotation="90"
                                           FontSize="14"
                                           TextColor="{StaticResource Danger}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Advanced options"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Danger}"
                                           VerticalOptions="Center" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDangerZoneToggled" />
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <VerticalStackLayout x:Name="DangerZoneContent"
                                                     IsVisible="False"
                                                     Spacing="12">
                                    <Label Text="Delete everything only if you truly want a fresh start."
                                           FontSize="14"
                                           TextColor="{StaticResource Danger}" />
                                    <Button Text="Delete All Data"
                                            Clicked="OnClearAllClicked"
                                            BackgroundColor="{StaticResource Danger}"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            HeightRequest="48"
                                            FontSize="15" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="ThemeSelectionOverlay"
              IsVisible="False"
              Opacity="0"
              Padding="22"
              BackgroundColor="{AppThemeBinding Light={StaticResource OverlayLight}, Dark={StaticResource OverlayDark}}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="ThemeSelectionBackdrop_Tapped" />
            </Grid.GestureRecognizers>
            <Border x:Name="ThemeSelectionCard"
                    Padding="0"
                    MaximumWidthRequest="430"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ThemeSelectionCard_Tapped" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#40000000" Offset="0,18" Radius="34" Opacity="0.35" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">
                    <Grid Padding="22"
                          ColumnDefinitions="*,Auto">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{AppThemeBinding Light={StaticResource HeroStartLight}, Dark={StaticResource HeroStartDark}}" Offset="0.0" />
                                <GradientStop Color="{AppThemeBinding Light={StaticResource HeroMidLight}, Dark={StaticResource HeroMidDark}}" Offset="0.6" />
                                <GradientStop Color="{AppThemeBinding Light={StaticResource HeroEndLight}, Dark={StaticResource HeroEndDark}}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <VerticalStackLayout Spacing="8">
                            <Border Padding="10,5"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource HeroGlassLight}, Dark={StaticResource HeroGlassDark}}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999" />
                                </Border.StrokeShape>
                                <Label Text="Appearance"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}" />
                            </Border>

                            <Label Text="Choose your theme"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}" />

                            <Label Text="Lock Swipely to a palette or let it follow your phone."
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource HeroSubtleLight}, Dark={StaticResource HeroSubtleDark}}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                WidthRequest="36"
                                HeightRequest="36"
                                BackgroundColor="{AppThemeBinding Light={StaticResource HeroGlassLight}, Dark={StaticResource HeroGlassDark}}"
                                StrokeThickness="0"
                                VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Button Text="X"
                                    Padding="0"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}"
                                    Clicked="ThemeSelectionClose_Clicked" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Padding="22" Spacing="12">
                        <Border x:Name="ThemeAutoOption"
                                Padding="16"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ThemeAuto_Tapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="21" />
                                    </Border.StrokeShape>
                                    <Label Text="A" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="Auto" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="Follow the phone theme." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                                <Label x:Name="ThemeAutoCheck" Grid.Column="2" Text="" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Accent}" VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="ThemeLightOption"
                                Padding="16"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ThemeLight_Tapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource WarningSoftLight}" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="21" />
                                    </Border.StrokeShape>
                                    <Label Text="L" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Warning}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="Light" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="Bright, soft, and easy for daytime use." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                                <Label x:Name="ThemeLightCheck" Grid.Column="2" Text="" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Accent}" VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="ThemeDarkOption"
                                Padding="16"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ThemeDark_Tapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource SurfaceAltDark}" Stroke="{StaticResource BorderColorDark}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="21" />
                                    </Border.StrokeShape>
                                    <Label Text="D" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryDark}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="Dark" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="A dedicated Swipely dark palette." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                                <Label x:Name="ThemeDarkCheck" Grid.Column="2" Text="" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Accent}" VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="MonthSelectionOverlay"
              IsVisible="False"
              BackgroundColor="{AppThemeBinding Light={StaticResource OverlayLight}, Dark={StaticResource OverlayDark}}">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    WidthRequest="340"
                    HeightRequest="480"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Content>
                    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
                        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,20">
                            <Label Text="Select Month to Clear"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            <Label Text="Choose the month you want to clear data for"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <ScrollView Grid.Row="1">
                            <VerticalStackLayout x:Name="MonthsContainer" Spacing="6" />
                        </ScrollView>

                        <HorizontalStackLayout Grid.Row="2"
                                               Spacing="12"
                                               HorizontalOptions="Center"
                                               Margin="0,20,0,0">
                            <Button Text="Cancel"
                                    Clicked="OnCancelMonthSelection"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}"
                                    BorderWidth="1"
                                    WidthRequest="120"
                                    HeightRequest="44" />

                            <Button x:Name="ConfirmClearButton"
                                    Text="Clear Data"
                                    Clicked="OnConfirmClearMonth"
                                    IsEnabled="False"
                                    BackgroundColor="{Binding Source={x:Reference ConfirmClearButton}, Path=IsEnabled, Converter={StaticResource EnabledToColorConverter}}"
                                    TextColor="{Binding Source={x:Reference ConfirmClearButton}, Path=IsEnabled, Converter={StaticResource EnabledToTextColorConverter}}"
                                    FontAttributes="Bold"
                                    WidthRequest="120"
                                    HeightRequest="44" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border.Content>
            </Border>
        </Grid>

        <Grid x:Name="DeleteMonthOverlay"
              IsVisible="False"
              BackgroundColor="{AppThemeBinding Light={StaticResource OverlayLight}, Dark={StaticResource OverlayDark}}">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    WidthRequest="360"
                    HeightRequest="340"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Content>
                    <Grid RowDefinitions="Auto,*,Auto" Margin="28,28,28,24">
                        <VerticalStackLayout Grid.Row="0" Spacing="12" HorizontalOptions="Center">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSoftLight}, Dark={StaticResource WarningSoftDark}}"
                                    WidthRequest="56"
                                    HeightRequest="56"
                                    HorizontalOptions="Center"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                <Border.Content>
                                    <Label Text="!"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Warning}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border.Content>
                            </Border>

                            <Label Text="Delete Month Data?"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1"
                                             Spacing="8"
                                             VerticalOptions="Center"
                                             Margin="0,16,0,16">
                            <Label x:Name="DeleteMonthMessage"
                                   Text="Are you sure you want to permanently delete all time tracking data for [Month]?"
                                   FontSize="15"
                                   HorizontalTextAlignment="Center"
                                   LineHeight="1.3" />

                            <Label Text="This action cannot be undone."
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Warning}"
                                   HorizontalOptions="Center"
                                   Margin="0,6,0,0" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Row="2"
                                               Spacing="12"
                                               HorizontalOptions="Center">
                            <Button Text="Cancel"
                                    Clicked="OnCancelDeleteMonth"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}"
                                    BorderWidth="1"
                                    WidthRequest="120"
                                    HeightRequest="44"
                                    FontSize="15"
                                    FontAttributes="Bold" />

                            <Button Text="Delete"
                                    Clicked="OnFinalConfirmDeleteMonth"
                                    BackgroundColor="{StaticResource Warning}"
                                    TextColor="White"
                                    WidthRequest="120"
                                    HeightRequest="44"
                                    FontSize="15"
                                    FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border.Content>
            </Border>
        </Grid>

        <Grid x:Name="DeleteAllOverlay"
              IsVisible="False"
              BackgroundColor="{AppThemeBinding Light={StaticResource OverlayLight}, Dark={StaticResource OverlayDark}}">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    WidthRequest="380"
                    HeightRequest="400"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Content>
                    <Grid RowDefinitions="Auto,*,Auto" Margin="32,32,32,24">
                        <VerticalStackLayout Grid.Row="0" Spacing="16" HorizontalOptions="Center">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource DangerSoftLight}, Dark={StaticResource DangerSoftDark}}"
                                    WidthRequest="64"
                                    HeightRequest="64"
                                    HorizontalOptions="Center"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="32" />
                                </Border.StrokeShape>
                                <Border.Content>
                                    <Label Text="!"
                                           FontSize="28"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Danger}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border.Content>
                            </Border>

                            <Label Text="Delete All Data?"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1"
                                             Margin="0,20,0,20"
                                             Spacing="12"
                                             VerticalOptions="Center">
                            <Label Text="This action will permanently delete:"
                                   FontSize="16"
                                   HorizontalOptions="Center" />

                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="•" TextColor="{StaticResource Danger}" FontSize="16" />
                                    <Label Text="All time tracking records"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Label Text="•" TextColor="{StaticResource Danger}" FontSize="16" />
                                    <Label Text="Historical data and statistics"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Label Text="•" TextColor="{StaticResource Danger}" FontSize="16" />
                                    <Label Text="All calendar entries"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Label Text="This action cannot be undone."
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Danger}"
                                   HorizontalOptions="Center"
                                   Margin="0,4,0,0" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Row="2"
                                               Spacing="16"
                                               HorizontalOptions="Center">
                            <Button Text="Cancel"
                                    Clicked="OnCancelDeleteAll"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}"
                                    BorderWidth="1"
                                    WidthRequest="140"
                                    HeightRequest="48"
                                    FontSize="16"
                                    FontAttributes="Bold" />

                            <Button Text="Delete All"
                                    Clicked="OnConfirmDeleteAll"
                                    BackgroundColor="{StaticResource Danger}"
                                    TextColor="White"
                                    WidthRequest="140"
                                    HeightRequest="48"
                                    FontSize="16"
                                    FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border.Content>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
