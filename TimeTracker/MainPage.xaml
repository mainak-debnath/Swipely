<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="TimeTracker.MainPage"
             Title="Home"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="24,18,24,28" Spacing="18">

            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label x:Name="WelcomeLabel"
                       Text="Today"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                <Border Grid.Column="1"
                        Padding="12,6"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label x:Name="TargetHoursLabel"
                           Text="Goal 8h 00m"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Accent}" />
                </Border>

                <Label Grid.Row="1"
                       Text="Your office time at a glance"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </Grid>

            <Border Padding="22"
                    StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Color="{AppThemeBinding Light={StaticResource HeroStartLight}, Dark={StaticResource HeroStartDark}}" Offset="0.0" />
                            <GradientStop Color="{AppThemeBinding Light={StaticResource HeroMidLight}, Dark={StaticResource HeroMidDark}}" Offset="0.5" />
                            <GradientStop Color="{AppThemeBinding Light={StaticResource HeroEndLight}, Dark={StaticResource HeroEndDark}}" Offset="1.0" />
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">
                    <Border x:Name="StatusPill"
                            Padding="12,6"
                            HorizontalOptions="Start"
                            BackgroundColor="{AppThemeBinding Light={StaticResource HeroGlassLight}, Dark={StaticResource HeroGlassDark}}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="999" />
                        </Border.StrokeShape>
                        <Label x:Name="StatusLabel"
                               Text="Currently out"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}" />
                    </Border>

                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="ProgressTimeLabel"
                               Text="0h 00m / 8h 00m"
                               FontSize="34"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}" />
                        <Label x:Name="ProgressStatusLabel"
                               Text="Ready to start your day"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource HeroSubtleLight}, Dark={StaticResource HeroSubtleDark}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Today's progress"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource HeroSubtleLight}, Dark={StaticResource HeroSubtleDark}}" />
                            <Border Grid.Column="1"
                                    Padding="10,4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource HeroGlassLight}, Dark={StaticResource HeroGlassDark}}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999" />
                                </Border.StrokeShape>
                                <Label x:Name="PercentageLabel"
                                       Text="0%"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}" />
                            </Border>
                        </Grid>

                        <Grid x:Name="ProgressTrack"
                              HeightRequest="12"
                              WidthRequest="320"
                              HorizontalOptions="Start">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource ProgressTrackLight}, Dark={StaticResource ProgressTrackDark}}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999" />
                                </Border.StrokeShape>
                            </Border>

                            <Border x:Name="ProgressFill"
                                    WidthRequest="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ProgressAccentLight}, Dark={StaticResource ProgressAccentDark}}"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999" />
                                </Border.StrokeShape>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <Button x:Name="SwipeActionButton"
                            Text="Swipe in"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceLight}}"
                            TextColor="{StaticResource Accent}"
                            FontSize="17"
                            HeightRequest="54" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Padding="16,16" HeightRequest="130" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Grid RowDefinitions="Auto,48,Auto">
                        <Label Text="Office this week" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label x:Name="OfficeDaysWeekLabel" Grid.Row="1" Text="0 / 3" FontSize="24" FontAttributes="Bold" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label x:Name="OfficeDaysLeftWeekLabel" Grid.Row="2" Text="Weekly target met" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Padding="16,16" HeightRequest="130" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Grid RowDefinitions="Auto,48,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <Label Text="Weekly streak" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Border Grid.Column="1"
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    Padding="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="WeeklyStreakInfo_Tapped" />
                                </Border.GestureRecognizers>
                                <Label Text="i"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Accent}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </Grid>
                        <Label x:Name="WeeklyStreakLabel" Grid.Row="1" Text="0" FontSize="24" FontAttributes="Bold" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label x:Name="BestWeeklyStreakLabel" Grid.Row="2" Text="Best: 0 weeks" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="16,16" HeightRequest="130" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Grid RowDefinitions="Auto,48,Auto">
                        <Label Text="Goal days this month" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label x:Name="GoalDaysLabel" Grid.Row="1" Text="0" FontSize="24" FontAttributes="Bold" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Grid.Row="2" Text="This month" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Padding="20" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Last recorded swipe"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label x:Name="LastActionLabel"
                           Text="No swipe recorded yet"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label x:Name="LastActionTimeLabel"
                           Text=""
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label x:Name="LastActionDateLabel"
                           Text=""
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Today&apos;s activity"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Text="Every swipe pair is grouped into one session."
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                WidthRequest="96"
                                HeightRequest="40"
                                StrokeThickness="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource HeroMidDark}}" Offset="0.0" />
                                    <GradientStop Color="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource HeroEndDark}}" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Button x:Name="ToggleLogsButton"
                                    Text="Show"
                                    Padding="12,8"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource White}}"
                                    Clicked="ToggleLogsButton_Clicked" />
                        </Border>
                    </Grid>

                    <StackLayout x:Name="LogsSection"
                                 IsVisible="False"
                                 Opacity="0"
                                 TranslationY="-8">
                        <CollectionView x:Name="TodayLogCollection"
                                        SelectionMode="None"
                                        EmptyView="No sessions recorded for today yet." />
                    </StackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

        <Grid x:Name="WeeklyStreakInfoOverlay"
              IsVisible="False"
              Opacity="0"
              Padding="22"
              BackgroundColor="{AppThemeBinding Light={StaticResource OverlayLight}, Dark={StaticResource OverlayDark}}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="WeeklyStreakInfoBackdrop_Tapped" />
            </Grid.GestureRecognizers>
            <Border x:Name="WeeklyStreakInfoCard"
                    Padding="0"
                    MaximumWidthRequest="420"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="WeeklyStreakInfoCard_Tapped" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#40000000" Offset="0,18" Radius="34" Opacity="0.35" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">
                    <Grid Padding="22"
                          ColumnDefinitions="*,Auto">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{AppThemeBinding Light={StaticResource HeroStartLight}, Dark={StaticResource HeroStartDark}}" Offset="0.0" />
                                <GradientStop Color="{AppThemeBinding Light={StaticResource HeroMidLight}, Dark={StaticResource HeroMidDark}}" Offset="0.6" />
                                <GradientStop Color="{AppThemeBinding Light={StaticResource HeroEndLight}, Dark={StaticResource HeroEndDark}}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <VerticalStackLayout Spacing="8">
                            <Border Padding="10,5"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource HeroGlassLight}, Dark={StaticResource HeroGlassDark}}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999" />
                                </Border.StrokeShape>
                                <Label Text="Weekly rhythm"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}" />
                            </Border>

                            <Label Text="How your streak works"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}" />

                            <Label x:Name="WeeklyStreakInfoSummaryLabel"
                                   Text="Complete your weekly office-day target to keep the streak alive."
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource HeroSubtleLight}, Dark={StaticResource HeroSubtleDark}}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                WidthRequest="36"
                                HeightRequest="36"
                                BackgroundColor="{AppThemeBinding Light={StaticResource HeroGlassLight}, Dark={StaticResource HeroGlassDark}}"
                                StrokeThickness="0"
                                VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Button Text="X"
                                    Padding="0"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}"
                                    Clicked="WeeklyStreakInfoClose_Clicked" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Padding="22" Spacing="14">
                        <Border Padding="16"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="What counts"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label x:Name="WeeklyStreakInfoTargetLabel"
                                       Text="A week counts when your office days reach the target set in Settings."
                                       FontSize="13"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSoftLight}, Dark={StaticResource SuccessSoftDark}}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="No harsh reset"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="The current week only joins the streak after the target is met. An unfinished current week does not break it."
                                       FontSize="13"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="Got it"
                                HeightRequest="48"
                                CornerRadius="18"
                                FontAttributes="Bold"
                                BackgroundColor="{StaticResource Accent}"
                                TextColor="White"
                                Clicked="WeeklyStreakInfoClose_Clicked" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
