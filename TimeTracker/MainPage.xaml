<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="TimeTracker.MainPage"
             Title="Home"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24,18,24,28" Spacing="18">

            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label x:Name="WelcomeLabel"
                       Text="Today"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                <Border Grid.Column="1"
                        Padding="12,6"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label x:Name="TargetHoursLabel"
                           Text="Goal 8h 00m"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Accent}" />
                </Border>

                <Label Grid.Row="1"
                       Text="Your office time at a glance"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </Grid>

            <Border Padding="22"
                    StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Color="{AppThemeBinding Light={StaticResource HeroStartLight}, Dark={StaticResource HeroStartDark}}" Offset="0.0" />
                            <GradientStop Color="{AppThemeBinding Light={StaticResource HeroMidLight}, Dark={StaticResource HeroMidDark}}" Offset="0.5" />
                            <GradientStop Color="{AppThemeBinding Light={StaticResource HeroEndLight}, Dark={StaticResource HeroEndDark}}" Offset="1.0" />
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">
                    <Border x:Name="StatusPill"
                            Padding="12,6"
                            HorizontalOptions="Start"
                            BackgroundColor="{AppThemeBinding Light={StaticResource HeroGlassLight}, Dark={StaticResource HeroGlassDark}}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="999" />
                        </Border.StrokeShape>
                        <Label x:Name="StatusLabel"
                               Text="Currently out"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}" />
                    </Border>

                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="ProgressTimeLabel"
                               Text="0h 00m / 8h 00m"
                               FontSize="34"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}" />
                        <Label x:Name="ProgressStatusLabel"
                               Text="Ready to start your day"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource HeroSubtleLight}, Dark={StaticResource HeroSubtleDark}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Grid x:Name="ProgressTrack"
                              HeightRequest="14"
                              WidthRequest="320"
                              HorizontalOptions="Start">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource HeroTrackLight}, Dark={StaticResource HeroTrackDark}}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999" />
                                </Border.StrokeShape>
                            </Border>

                            <Border x:Name="ProgressFill"
                                    WidthRequest="0"
                                    BackgroundColor="#FFFFFF"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999" />
                                </Border.StrokeShape>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="TimeLeftLabel"
                                   Text="Time left: 8h 00m"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource HeroSubtleLight}, Dark={StaticResource HeroSubtleDark}}" />
                            <Label x:Name="PercentageLabel"
                                   Grid.Column="1"
                                   Text="0%"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource HeroTextLight}, Dark={StaticResource HeroTextDark}}" />
                        </Grid>
                    </VerticalStackLayout>

                    <Button x:Name="SwipeActionButton"
                            Text="Swipe in"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceLight}}"
                            TextColor="{StaticResource Accent}"
                            FontSize="17"
                            HeightRequest="54" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Padding="16" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sessions today" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label x:Name="SessionsCountLabel" Text="0" FontSize="24" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Padding="16" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Current streak" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label x:Name="StreakCountLabel" Text="0" FontSize="24" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" Padding="16" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Goal days" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label x:Name="GoalDaysLabel" Text="0" FontSize="24" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Padding="20" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Last recorded swipe"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label x:Name="LastActionLabel"
                           Text="No swipe recorded yet"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label x:Name="LastActionTimeLabel"
                           Text=""
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label x:Name="LastActionDateLabel"
                           Text=""
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Today&apos;s activity"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Text="Every swipe pair is grouped into one session."
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                WidthRequest="96"
                                HeightRequest="40"
                                StrokeThickness="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource HeroMidDark}}" Offset="0.0" />
                                    <GradientStop Color="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource HeroEndDark}}" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Button x:Name="ToggleLogsButton"
                                    Text="Show"
                                    Padding="12,8"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource White}}"
                                    Clicked="ToggleLogsButton_Clicked" />
                        </Border>
                    </Grid>

                    <StackLayout x:Name="LogsSection"
                                 IsVisible="False"
                                 Opacity="0"
                                 TranslationY="-8">
                        <CollectionView x:Name="TodayLogCollection"
                                        SelectionMode="None"
                                        EmptyView="No sessions recorded for today yet." />
                    </StackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
