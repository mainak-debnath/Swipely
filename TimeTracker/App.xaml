<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TimeTracker.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Compatibility aliases used across older pages -->
            <Color x:Key="PageBackgroundColor">#F4F7FB</Color>
            <Color x:Key="PrimaryTextColor">#132238</Color>
            <Color x:Key="SecondaryTextColor">#60708A</Color>
            <Color x:Key="CardBackgroundColor">#FCFDFF</Color>
            <Color x:Key="EntryBackgroundColor">#EEF3FF</Color>
            <Color x:Key="ButtonColor">#2D5BFF</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
